APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sesa_bot
DB_USERNAME=root
DB_PASSWORD=
# O bot cria as tabelas dele sem especificar charset/collation, então pega
# o padrão do MySQL 8 (utf8mb4_0900_ai_ci). Definindo isso aqui também,
# qualquer tabela/coluna nova criada por uma migration do Laravel nasce
# com a mesma collation -- evita erro "Illegal mix of collations" ao
# comparar colunas do Laravel com colunas do bot (ex: clientes.nome com
# chamados.setor).
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Segundo fator de login: números de técnico autorizados, separados por
# vírgula (ex: 5586999999999,5586888888888). Fica vazio aqui de propósito
# -- o valor real é definido só nas variáveis do serviço no Railway,
# nunca comitado.
TECNICO_NUMBERS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# This app and T.I-Sesa-bot (the WhatsApp bot) share the same MySQL
# database/table ("chamados") -- the bot writes to it directly with raw
# SQL, it does not call an API. Point DB_* below at the same database the
# bot uses (DB_NAME=sesa_bot in the bot's own .env).
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
